{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/domannand95-svg/sovereign-workbench-plugins/schemas/plugin-manifest-v1.schema.json",
  "title": "Sovereign Plugin Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["plugin_id", "version", "description", "accepted_suffixes", "deterministic", "network", "requested_capabilities"],
  "properties": {
    "plugin_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "description": {"type": "string", "minLength": 1},
    "accepted_suffixes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^\\.[a-z0-9]+$"}},
    "deterministic": {"type": "boolean"},
    "network": {"enum": ["denied", "allowlisted"]},
    "requested_capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$"}}
  }
}
